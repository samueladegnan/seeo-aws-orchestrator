# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicitly declare text files
*.md text
*.py text
*.tf text
*.yml text
*.yaml text
*.sh text
*.html text
*.css text
*.js text
*.scss text
*.json text
*.toml text
*.txt text

# Denote binary files
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.zip binary
*.tar binary
*.gz binary
