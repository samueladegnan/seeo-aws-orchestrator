# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# If you find yourself ignoring temporary files generated by your operating system,
# consider using a global gitignore: https://help.github.com/articles/ignoring-files

# Ignore bundler config and vendored gems.
/.bundle
/vendor/bundle

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore uploaded files in development.
/storage/*
!/storage/.gitkeep

# Ignore master key for decrypting credentials and other secrets.
/config/master.key
/config/credentials.yml.enc
/config/credentials/*.yml.enc
/config/credentials/*.key

# Ignore dotenv files.
.env
.env.local
.env.*.local

# Ignore precompiled assets.
/public/assets

# Ignore Byebug command history file.
.byebug_history

# Ignore coverage reports generated by SimpleCov.
/coverage

# Ignore RubyMine / VS Code files.
.idea
.vscode

# Ignore OS generated files.
.DS_Store
Thumbs.db
