#!/usr/bin/env ruby
# frozen_string_literal: true

# This file was generated by Bundler.
#
# The application 'bundle' is installed using the following command:
#   $ bundle install

require "rubygems"

m = Module.new do
  module_function

  def invoked_as_script?
    File.expand_path($0) == File.expand_path(__FILE__)
  end

  def env_var_version
    ENV["BUNDLER_VERSION"]
  end

  def cli_arg_version
    return unless invoked_as_script? # || nil
    ARGV.find { |arg| arg =~ /\A-(?:[vV]|version)\z/ }
  end

  def bundler_version
    @bundler_version ||= env_var_version || cli_arg_version
  end

  def load_bundler!
    require "bundler"
  rescue LoadError => e
    warn "Could not load Bundler: #{e.message}"
    exit 1
  end

  def gemfile
    gemfile = ENV["BUNDLE_GEMFILE"]
    gemfile ||= File.expand_path("../Gemfile", __dir__)
    gemfile
  end
end

m.load_bundler!
load Gem.bin_path("bundler", "bundle")
