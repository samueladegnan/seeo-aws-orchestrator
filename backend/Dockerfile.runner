# syntax=docker/dockerfile:1
FROM ruby:3.3-slim

# This image contains provider tooling, not provider credentials. Authenticate at
# runtime with workload identity, short-lived environment variables, or mounted
# provider config supplied by the deployment platform.
ARG TARGETARCH
ENV DEBIAN_FRONTEND=noninteractive \
    PATH="/root/google-cloud-sdk/bin:/root/bin:${PATH}"

RUN apt-get update -qq && apt-get install -y --no-install-recommends \
      build-essential \
      ca-certificates \
      curl \
      gnupg \
      jq \
      libsqlite3-dev \
      python3 \
      unzip \
    && rm -rf /var/lib/apt/lists/*

# AWS CLI v2 archive and checksums are pinned for reproducible builds.
RUN set -eux; \
    case "${TARGETARCH:-amd64}" in \
      amd64) aws_arch="x86_64"; aws_sha256="f5fbb3304307ce008756356fadf7855d377b4342da9911728669265ec1ec36dc" ;; \
      arm64) aws_arch="aarch64"; aws_sha256="daec73b304ffafa595172a6a598a85bd92bde145c25acf97270d44430e42bcd6" ;; \
      *) echo "Unsupported AWS CLI architecture: ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    aws_url="https://awscli.amazonaws.com/awscli-exe-linux-${aws_arch}-2.31.0.zip"; \
    curl -fsSL "$aws_url" -o /tmp/awscliv2.zip; \
    echo "${aws_sha256}  /tmp/awscliv2.zip" | sha256sum -c -; \
    unzip -q /tmp/awscliv2.zip -d /tmp; \
    /tmp/aws/install --bin-dir /usr/local/bin --install-dir /usr/local/aws-cli; \
    rm -rf /tmp/aws /tmp/awscliv2.zip

# Azure CLI via Microsoft's signed package repository.
RUN set -eux; \
    curl -fsSL https://packages.microsoft.com/keys/microsoft.asc | gpg --dearmor -o /usr/share/keyrings/microsoft.gpg; \
    chmod a+r /usr/share/keyrings/microsoft.gpg; \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/microsoft.gpg] https://packages.microsoft.com/repos/azure-cli/ bookworm main" > /etc/apt/sources.list.d/azure-cli.list; \
    apt-get update -qq; \
    apt-get install -y --no-install-recommends azure-cli; \
    rm -rf /var/lib/apt/lists/*

# Google Cloud CLI via Google's signed APT repository.
RUN set -eux; \
    curl -fsSL https://packages.cloud.google.com/apt/doc/apt-key.gpg | gpg --dearmor -o /usr/share/keyrings/cloud.google.gpg; \
    chmod a+r /usr/share/keyrings/cloud.google.gpg; \
    echo "deb [signed-by=/usr/share/keyrings/cloud.google.gpg] https://packages.cloud.google.com/apt cloud-sdk main" > /etc/apt/sources.list.d/google-cloud-sdk.list; \
    apt-get update -qq; \
    apt-get install -y --no-install-recommends google-cloud-cli; \
    rm -rf /var/lib/apt/lists/*

# OCI CLI is installed without initializing a profile. Credentials are supplied
# by the runtime environment or an external workload identity mechanism.
RUN set -eux; \
    oci_install_url="https://raw.githubusercontent.com/oracle/oci-cli/95950b1a2d148eab83993d64c2e0cfe5c185d3ae/scripts/install/install.sh"; \
    curl -fsSL "$oci_install_url" -o /tmp/install-oci.sh; \
    echo "079dcc9a3e2a61ec692400e30169c9996b2998ac8c4e205198ed5863283fcb76  /tmp/install-oci.sh" | sha256sum -c -; \
    bash /tmp/install-oci.sh --accept-all-defaults --install-dir /opt/oci-cli --exec-dir /usr/local/bin; \
    rm -f /tmp/install-oci.sh

WORKDIR /app
COPY Gemfile Gemfile.lock* ./
RUN bundle install --jobs=4 --retry=3
COPY . .
RUN useradd -m seeo && chown -R seeo:seeo /app
USER seeo

EXPOSE 3000
CMD ["sh", "-c", "bundle exec rails db:prepare && bundle exec rails server -b 0.0.0.0"]
