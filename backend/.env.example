# SEEO Rails backend configuration
# This file contains placeholders only. Copy it to .env locally; never commit .env.

# API security (development values only)
SEEO_API_KEY=dev-change-me-in-production
SEEO_JWT_SECRET=dev-change-me-in-production

# Multi-cloud runtime
SEEO_DEFAULT_PROVIDER=aws
SEEO_ALLOWED_PROVIDERS=aws,azure,gcp,oci
SEEO_MOCK_MODE=true
SEEO_MOCK_PROVISIONING_DELAY_SECONDS=2
SEEO_APP_VERSION=0.3.0

# Provider regions and control-plane integration IDs
SEEO_AWS_REGION=us-east-1
SEEO_AZURE_REGION=eastus
SEEO_GCP_REGION=us-central1
SEEO_OCI_REGION=us-ashburn-1
SEEO_AWS_PROJECT=
SEEO_AZURE_PROJECT=
SEEO_GCP_PROJECT=
SEEO_GCP_ZONE=us-central1-a
# Use the matching provider network/subnet outputs from Terraform.
SEEO_AWS_NETWORK_ID=
SEEO_AZURE_NETWORK_ID=
SEEO_GCP_NETWORK_ID=
SEEO_OCI_NETWORK_ID=
SEEO_AWS_SUBNET_ID=
SEEO_AZURE_SUBNET_ID=
SEEO_GCP_SUBNET_ID=
SEEO_OCI_SUBNET_ID=
SEEO_OCI_PROJECT=
SEEO_OCI_COMPARTMENT_ID=
SEEO_OCI_AVAILABILITY_DOMAIN=
SEEO_OCI_IMAGE_ID=

# Provider-specific adapter settings. Supply credentials through workload identity,
# a secret manager, or the provider's standard local credential chain; never commit them.
AWS_PROFILE=
SEEO_AWS_KEY_PAIR=
SEEO_AWS_IMAGE_ID=
SEEO_AWS_SECURITY_GROUP_ID=
SEEO_AZURE_RESOURCE_GROUP=
SEEO_AZURE_IMAGE=Ubuntu2204
SEEO_AWS_INSTANCE_PROFILE=
SEEO_AWS_SECRET_NAME=seeo/runtime/credentials
SEEO_AZURE_CREDENTIALS=
SEEO_GCP_CREDENTIALS=
SEEO_OCI_CREDENTIALS=

# Shared Rails control-plane database
DATABASE_URL=storage/development.sqlite3
SEEO_TTL_CHECK_INTERVAL_SECONDS=60

# CORS: use an explicit origin outside local development.
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_CREDENTIALS=false
