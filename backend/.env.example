# SEEO Backend Configuration
APP_NAME=SEEO - Secure Ephemeral Environment Orchestrator
DEBUG=false

# Security
API_KEY=change-me-in-production

# AWS
AWS_REGION=us-east-1
# AWS_PROFILE=default

# EC2 Configuration
EC2_KEY_PAIR=my-key
# EC2_AMI_ID=ami-1234567890abcdef0
EC2_INSTANCE_TYPE=t3.micro
EC2_SUBNET_ID=subnet-1234567890abcdef0
EC2_SECURITY_GROUP_ID=sg-1234567890abcdef0
IAM_INSTANCE_PROFILE=seeo-ec2-instance-profile

# DynamoDB / Secrets Manager
ENVIRONMENTS_TABLE=seeo-environments
SECRETS_SECRET_NAME=seeo/runtime/credentials

# TTL checker
TTL_CHECK_INTERVAL_SECONDS=60

# CORS
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_CREDENTIALS=false
