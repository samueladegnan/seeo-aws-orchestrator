# SEEO Rails backend configuration

# API Security
SEEO_API_KEY=dev-change-me-in-production
SEEO_JWT_SECRET=dev-change-me-in-production

# AWS
AWS_REGION=us-east-1
AWS_PROFILE=

# EC2 / Infrastructure
SEEO_EC2_KEY_PAIR=
SEEO_EC2_AMI_ID=
SEEO_EC2_INSTANCE_TYPE=t3.micro
SEEO_EC2_SUBNET_ID=
SEEO_EC2_SECURITY_GROUP_ID=
SEEO_IAM_INSTANCE_PROFILE=

# DynamoDB and Secrets Manager
SEEO_ENVIRONMENTS_TABLE=seeo-environments
SEEO_AUDIT_LOG_TABLE=seeo-audit-logs
SEEO_SECRETS_SECRET_NAME=seeo/runtime/credentials

# Background TTL monitor
SEEO_TTL_CHECK_INTERVAL_SECONDS=60

# CORS
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_CREDENTIALS=false

# Local development: use in-memory mock AWS instead of real APIs
SEEO_MOCK_AWS=true
